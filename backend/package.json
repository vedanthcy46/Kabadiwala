{
  "name": "kabadiwala-connect-db",
  "version": "1.0.0",
  "description": "PostgreSQL schema, seed data, and connection layer for Kabadiwala Connect (SIH26229)",
  "main": "src/db.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test-connection": "node src/test-connection.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "reset": "node src/reset.js",
    "keepalive": "node scripts/keepalive.js",
    "setup": "node src/setup.js",
    "setup:force": "node src/setup.js -- --force",
    "setup:schema": "node src/setup.js -- --skip-seed",
    "setup:dry-run": "node src/setup.js -- --dry-run",
    "seed:prices": "node scripts/seedPricesFromDataset.js",
    "seed:prices:dry": "node scripts/seedPricesFromDataset.js --dry-run",
    "export:ai-dataset": "node scripts/export_training_dataset.js",
    "eval:ai-dataset": "node scripts/evaluate_training_dataset.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
